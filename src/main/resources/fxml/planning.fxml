<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sn.epf.pointage.ui.PlanningController"
      spacing="18"
      styleClass="content-root">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <Label text="Planning et assignations" styleClass="page-title"/>
    <Label text="Creation des cours, salles, assignations et generation automatique des seances." styleClass="page-subtitle"/>

    <HBox spacing="18">
        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="dashboard-card">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>
            <Label text="Cours" styleClass="card-title"/>
            <HBox spacing="10">
                <Button text="Ajouter un cours" onAction="#handleAddCours" styleClass="primary-button"/>
                <Button text="Actualiser" onAction="#handleRefresh" styleClass="secondary-button"/>
            </HBox>
            <TableView fx:id="coursTable" prefHeight="180">
                <columns>
                    <TableColumn fx:id="coursCodeColumn" text="Code" prefWidth="90"/>
                    <TableColumn fx:id="coursIntituleColumn" text="Intitule" prefWidth="180"/>
                    <TableColumn fx:id="coursFiliereColumn" text="Filiere" prefWidth="90"/>
                    <TableColumn fx:id="coursVolumeColumn" text="Volume" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="dashboard-card">
            <padding>
                <Insets top="18" right="18" bottom="18" left="18"/>
            </padding>
            <Label text="Salles" styleClass="card-title"/>
            <HBox spacing="10">
                <Button text="Ajouter une salle" onAction="#handleAddSalle" styleClass="primary-button"/>
                <Button text="Actualiser" onAction="#handleRefresh" styleClass="secondary-button"/>
            </HBox>
            <TableView fx:id="sallesTable" prefHeight="180">
                <columns>
                    <TableColumn fx:id="salleNomColumn" text="Nom" prefWidth="100"/>
                    <TableColumn fx:id="salleCapaciteColumn" text="Capacite" prefWidth="90"/>
                    <TableColumn fx:id="salleBatimentColumn" text="Batiment" prefWidth="130"/>
                    <TableColumn fx:id="salleEquipementsColumn" text="Equipements" prefWidth="160"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>

    <VBox spacing="12" styleClass="dashboard-card">
        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>
        <Label text="Assigner un cours et generer les seances" styleClass="card-title"/>
        <GridPane hgap="12" vgap="12">
            <Label text="Professeur" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="professeurCombo" prefWidth="220" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Cours" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <ComboBox fx:id="coursCombo" prefWidth="220" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Salle" GridPane.rowIndex="0" GridPane.columnIndex="4"/>
            <ComboBox fx:id="salleCombo" prefWidth="180" GridPane.rowIndex="0" GridPane.columnIndex="5"/>

            <Label text="Annee" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="anneeField" text="2025-2026" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Heures prevues" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="heuresPrevuesField" text="30" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <Label text="Jour" GridPane.rowIndex="1" GridPane.columnIndex="4"/>
            <ComboBox fx:id="jourCombo" prefWidth="180" GridPane.rowIndex="1" GridPane.columnIndex="5"/>

            <Label text="Heure debut" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="heureDebutField" text="08:00" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Heure fin" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <TextField fx:id="heureFinField" text="10:00" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

            <Label text="Frequence" GridPane.rowIndex="2" GridPane.columnIndex="4"/>
            <ComboBox fx:id="frequenceCombo" prefWidth="180" GridPane.rowIndex="2" GridPane.columnIndex="5"/>

            <Label text="Date debut" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dateDebutPicker" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Date fin" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
            <DatePicker fx:id="dateFinPicker" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

            <Button text="Creer l'assignation" onAction="#handleCreateAssignation" styleClass="primary-button"
                    GridPane.rowIndex="3" GridPane.columnIndex="5"/>
        </GridPane>
        <Label fx:id="messageLabel" styleClass="hint-text"/>
    </VBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="dashboard-card">
        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>
        <Label text="Seances planifiees" styleClass="card-title"/>
        <TableView fx:id="seancesTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="seanceDateColumn" text="Date et heure" prefWidth="180"/>
                <TableColumn fx:id="seanceDureeColumn" text="Duree" prefWidth="90"/>
                <TableColumn fx:id="seanceStatutColumn" text="Statut" prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
