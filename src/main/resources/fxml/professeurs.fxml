<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sn.epf.pointage.ui.ProfesseursController"
      spacing="18"
      styleClass="content-root">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <Label text="Gestion des professeurs" styleClass="page-title"/>
    <Label text="Recherche, enrolement, modification et desactivation des professeurs." styleClass="page-subtitle"/>

    <HBox spacing="12">
        <TextField fx:id="searchField" promptText="Rechercher par nom ou prenom" HBox.hgrow="ALWAYS"/>
        <Button text="Rechercher" onAction="#handleSearch" styleClass="secondary-button"/>
        <Button text="Actualiser" onAction="#handleRefresh" styleClass="secondary-button"/>
    </HBox>

    <HBox spacing="12">
        <Button text="Ajouter" onAction="#handleAdd" styleClass="primary-button"/>
        <Button text="Modifier" onAction="#handleEdit" styleClass="secondary-button"/>
        <Button text="Desactiver" onAction="#handleDeactivate" styleClass="danger-button"/>
        <Label fx:id="messageLabel" styleClass="hint-text"/>
    </HBox>

    <TableView fx:id="professeursTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="matriculeColumn" text="Matricule" prefWidth="150"/>
            <TableColumn fx:id="nomColumn" text="Nom" prefWidth="140"/>
            <TableColumn fx:id="prenomColumn" text="Prenom" prefWidth="140"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="230"/>
            <TableColumn fx:id="telephoneColumn" text="Telephone" prefWidth="130"/>
            <TableColumn fx:id="typeContratColumn" text="Contrat" prefWidth="120"/>
            <TableColumn fx:id="tauxHoraireColumn" text="Taux horaire" prefWidth="130"/>
            <TableColumn fx:id="actifColumn" text="Actif" prefWidth="80"/>
        </columns>
    </TableView>
</VBox>
