<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sn.epf.pointage.ui.RapportsController"
      spacing="18"
      styleClass="content-root">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <Label text="Rapports mensuels" styleClass="page-title"/>
    <Label text="Generation, validation et suivi des rapports d'heures realisees." styleClass="page-subtitle"/>

    <VBox spacing="12" styleClass="dashboard-card">
        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>

        <Label text="Generer un rapport" styleClass="card-title"/>
        <GridPane hgap="12" vgap="12">
            <Label text="Professeur" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="professeurCombo" prefWidth="320" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Mois" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <ComboBox fx:id="moisCombo" prefWidth="140" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <Label text="Annee" GridPane.rowIndex="0" GridPane.columnIndex="4"/>
            <TextField fx:id="anneeField" prefWidth="110" GridPane.rowIndex="0" GridPane.columnIndex="5"/>
        </GridPane>

        <HBox spacing="12">
            <Button text="Generer rapport" onAction="#handleGenerate" styleClass="primary-button"/>
            <Button text="Valider rapport selectionne" onAction="#handleValidate" styleClass="secondary-button"/>
            <Button text="Marquer paye" onAction="#handleMarkPaid" styleClass="secondary-button"/>
            <Button text="Actualiser" onAction="#handleRefresh" styleClass="secondary-button"/>
            <Label fx:id="messageLabel" styleClass="hint-text"/>
        </HBox>
    </VBox>

    <VBox spacing="10" styleClass="dashboard-card">
        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>

        <Label text="Rapports existants" styleClass="card-title"/>
        <TableView fx:id="rapportsTable" minHeight="420" prefHeight="420">
            <columns>
                <TableColumn fx:id="professeurColumn" text="Professeur" prefWidth="260"/>
                <TableColumn fx:id="periodeColumn" text="Periode" prefWidth="120"/>
                <TableColumn fx:id="heuresColumn" text="Heures" prefWidth="110"/>
                <TableColumn fx:id="montantColumn" text="Montant XOF" prefWidth="150"/>
                <TableColumn fx:id="statutColumn" text="Statut" prefWidth="130"/>
                <TableColumn fx:id="dateGenerationColumn" text="Generation" prefWidth="190"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
