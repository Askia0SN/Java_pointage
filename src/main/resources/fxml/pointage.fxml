<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sn.epf.pointage.ui.PointageController"
      spacing="18"
      styleClass="content-root">
    <padding>
        <Insets top="32" right="32" bottom="32" left="32"/>
    </padding>

    <Label text="Pointage professeur" styleClass="page-title"/>
    <Label fx:id="subtitleLabel" text="Seances du jour pour le professeur connecte." styleClass="page-subtitle"/>

    <HBox spacing="12">
        <Button text="Actualiser" onAction="#handleRefresh" styleClass="secondary-button"/>
        <Button text="Pointer debut" onAction="#handlePointerDebut" styleClass="primary-button"/>
        <Button text="Pointer fin" onAction="#handlePointerFin" styleClass="secondary-button"/>
        <Label fx:id="messageLabel" styleClass="hint-text"/>
    </HBox>

    <TableView fx:id="seancesTable" minHeight="360" prefHeight="420" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="coursColumn" text="Cours" prefWidth="260"/>
            <TableColumn fx:id="dateColumn" text="Date et heure" prefWidth="180"/>
            <TableColumn fx:id="dureeColumn" text="Duree" prefWidth="100"/>
            <TableColumn fx:id="statutColumn" text="Statut" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
